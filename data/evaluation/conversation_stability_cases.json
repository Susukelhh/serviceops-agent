{
  "dataset_id": "serviceops-conversation-stability",
  "version": "1.1.0",
  "description": "完全离线验证多轮订单指代、歧义澄清、主题切换、审批焦点、长期摘要、执行租约和幂等重放。v1.1使模拟图意图与真实业务路由一致：订单追问缺少唯一目标时仍属于order_status澄清，而不是human_handoff。",
  "thresholds": {
    "min_overall_pass_rate": 1.0,
    "min_resolution_accuracy": 1.0,
    "min_memory_accuracy": 1.0,
    "min_execution_safety_accuracy": 1.0,
    "min_isolation_accuracy": 1.0
  },
  "scenarios": [
    {
      "scenario_id": "owned-order-follow-up",
      "owner_user_id": "user-001",
      "turns": [
        {
          "message": "查询订单 SO100001",
          "idempotency_key": "stable-owned-0001",
          "expected_reason": "explicit_reference",
          "expected_standalone_question": "查询订单 SO100001",
          "expected_referenced_order_ids": ["SO100001"],
          "simulated_intent": "order_status",
          "simulated_verified_order_ids": ["SO100001"],
          "expected_memory": {
            "current_topic": "order_status",
            "active_order_id": "SO100001",
            "recent_order_ids": ["SO100001"],
            "recent_document_ids": [],
            "last_processed_sequence": 1
          }
        },
        {
          "message": "它现在到哪了？",
          "idempotency_key": "stable-owned-0002",
          "expected_reason": "verified_order_reference",
          "expected_standalone_question": "关于订单 SO100001，它现在到哪了？",
          "expected_referenced_order_ids": ["SO100001"],
          "simulated_intent": "order_status",
          "simulated_verified_order_ids": ["SO100001"],
          "expected_memory": {
            "current_topic": "order_status",
            "active_order_id": "SO100001",
            "recent_order_ids": ["SO100001"],
            "recent_document_ids": [],
            "last_processed_sequence": 2
          }
        }
      ]
    },
    {
      "scenario_id": "multi-order-ambiguity",
      "owner_user_id": "user-001",
      "turns": [
        {
          "message": "查询订单 SO100001 和 SO100002",
          "idempotency_key": "stable-multi-0001",
          "expected_reason": "explicit_reference",
          "expected_standalone_question": "查询订单 SO100001 和 SO100002",
          "expected_referenced_order_ids": ["SO100001", "SO100002"],
          "simulated_intent": "order_status",
          "simulated_verified_order_ids": ["SO100001", "SO100002"],
          "expected_memory": {
            "current_topic": "order_status",
            "active_order_id": null,
            "recent_order_ids": ["SO100001", "SO100002"],
            "recent_document_ids": [],
            "last_processed_sequence": 1
          }
        },
        {
          "message": "这个订单什么时候到？",
          "idempotency_key": "stable-multi-0002",
          "expected_reason": "ambiguous_order_reference",
          "expected_standalone_question": "订单追问存在多个候选，请先要求用户明确订单号：这个订单什么时候到？",
          "expected_needs_clarification": true,
          "expected_referenced_order_ids": [],
          "simulated_intent": "order_status",
          "expected_memory": {
            "current_topic": "order_status",
            "active_order_id": null,
            "recent_order_ids": ["SO100001", "SO100002"],
            "recent_document_ids": [],
            "last_processed_sequence": 2
          }
        }
      ]
    },
