# 所有环境变量统一使用 SERVICEOPS_ 前缀，避免与系统变量重名。
SERVICEOPS_APP_NAME=ServiceOps Agent
# 单机默认 local-1；Compose 两只 API 会分别覆盖成 agent-a 和 agent-b。
SERVICEOPS_INSTANCE_ID=local-1
SERVICEOPS_ENVIRONMENT=development
SERVICEOPS_LOG_LEVEL=INFO

# 本地默认把 Trace/Metrics 输出到控制台；生产建议改成 otlp_http 发送给 Collector。
SERVICEOPS_TELEMETRY_ENABLED=true
SERVICEOPS_TELEMETRY_EXPORTER=console
SERVICEOPS_OTEL_SERVICE_NAME=serviceops-agent
SERVICEOPS_OTEL_OTLP_ENDPOINT=http://127.0.0.1:4318
SERVICEOPS_OTEL_TRACE_SAMPLE_RATIO=1.0
SERVICEOPS_OTEL_METRIC_EXPORT_INTERVAL_MS=60000

# sqlite 让单机学习时的审批 Checkpoint 和退货业务记录在进程重启后仍然存在。
# Docker Compose 会覆盖成 postgres，让多个应用实例可以共同访问同一套服务端数据库。
SERVICEOPS_PERSISTENCE_BACKEND=sqlite
SERVICEOPS_CHECKPOINT_DATABASE_PATH=data/runtime/checkpoints.sqlite3
SERVICEOPS_BUSINESS_DATABASE_PATH=data/runtime/serviceops.sqlite3

# 只有把上面的后端改成 postgres 时才需要填写；真实密码不要提交到 Git。
# 格式可理解为：postgresql://用户名:密码@数据库机器:端口/数据库名
# SERVICEOPS_POSTGRES_DSN=postgresql://serviceops:请替换密码@127.0.0.1:5432/serviceops
SERVICEOPS_POSTGRES_POOL_MIN_SIZE=1
SERVICEOPS_POSTGRES_POOL_MAX_SIZE=5

# 本地首次运行可省略该字段并使用代码内明确标记的开发密钥。
# 团队共享、部署或 production 环境必须注入至少 32 字符的随机密钥，且不能提交到 Git。
# SERVICEOPS_JWT_SECRET_KEY=请在本机或密钥管理系统中填写随机值
SERVICEOPS_JWT_ISSUER=serviceops-local-issuer
SERVICEOPS_JWT_AUDIENCE=serviceops-agent-api
SERVICEOPS_JWT_ACCESS_TOKEN_MINUTES=30
SERVICEOPS_JWT_CLOCK_SKEW_SECONDS=10

# 默认使用 mock，项目无需密钥也能运行全部测试和关键词分类基线。
SERVICEOPS_LLM_BACKEND=mock

# 切换到 openai_compatible 后，填写服务商提供的模型名、密钥和兼容 API 地址。
# 不要把真实密钥提交到 Git；本地应复制本文件为 `.env` 后再填写。
SERVICEOPS_LLM_MODEL=replace-with-model-name
SERVICEOPS_LLM_API_KEY=
SERVICEOPS_LLM_BASE_URL=

# 使用函数调用生成 Pydantic 结构化输出；该方式兼容多数支持工具调用的现代模型。
SERVICEOPS_INTENT_CONFIDENCE_THRESHOLD=0.85
SERVICEOPS_LLM_TEMPERATURE=0.0
SERVICEOPS_LLM_TIMEOUT_SECONDS=30.0
SERVICEOPS_LLM_MAX_RETRIES=2

# Agent 默认使用确定性规划器；切换 llm 后由真实模型逐步提出工具调用或停止动作。
SERVICEOPS_AGENT_PLANNER_BACKEND=deterministic
# 单个请求最多实际执行三次工具，超过限制会停止并转人工。
SERVICEOPS_AGENT_MAX_TOOL_STEPS=3
# 单个 API 实例最多同时处理 8 个业务请求；超过后只短暂等待 0.05 秒。
SERVICEOPS_AGENT_MAX_IN_FLIGHT_REQUESTS=8
SERVICEOPS_AGENT_CAPACITY_QUEUE_TIMEOUT_SECONDS=0.05

# FAQ RAG 默认使用本地确定性哈希向量，不访问网络、不产生模型费用。
# 切换为 openai_compatible 后，会复用上面的 API Key 和 Base URL 调用千问 Embedding。
SERVICEOPS_EMBEDDING_BACKEND=hash
SERVICEOPS_EMBEDDING_MODEL=qwen3.7-text-embedding
SERVICEOPS_EMBEDDING_DIMENSIONS=1024
# qwen3.7-text-embedding同步接口每批最多20条；使用text-embedding-v4时应改为10。
SERVICEOPS_EMBEDDING_BATCH_SIZE=20

# 本机直接运行默认使用内存 Qdrant；Docker 会用 SERVICEOPS_QDRANT_URL 覆盖为独立服务。
SERVICEOPS_QDRANT_LOCATION=:memory:
# 连接独立服务时取消下一行注释；Compose 已自动注入 http://qdrant:6333。
# SERVICEOPS_QDRANT_URL=http://127.0.0.1:6333
# Qdrant Cloud 等受保护环境可以设置 API Key，本地 Docker 不需要。
# SERVICEOPS_QDRANT_API_KEY=
SERVICEOPS_QDRANT_TIMEOUT_SECONDS=10
SERVICEOPS_QDRANT_COLLECTION=serviceops_knowledge_v2
SERVICEOPS_KNOWLEDGE_SOURCE_PATH=data/seed/knowledge_documents.json

# RAG 只返回最相关的少量证据，低于阈值时不回答并进入人工接管。
SERVICEOPS_RAG_TOP_K=3
# 本地 hash 基线使用 0.10；切换真实语义 Embedding 后应通过评测集重新校准。
SERVICEOPS_RAG_SCORE_THRESHOLD=0.10
# deterministic_v1 在Embedding前拒绝天气、投资、医疗、代写、内部规则和凭据索取。
SERVICEOPS_RAG_QUERY_POLICY=deterministic_v1
# hybrid_rrf 表示 Qdrant 与 BM25 各自检索全库后，以 RRF 名次融合。
SERVICEOPS_RAG_RERANKER=hybrid_rrf
# 以下三个参数只服务旧 bm25 候选内重排实验，保留用于复现历史基线。
SERVICEOPS_RAG_RERANK_LEXICAL_WEIGHT=0.25
SERVICEOPS_RAG_RERANK_CANDIDATE_K=5
# 两路各自取回 8 个候选，再由 RRF 返回最终 SERVICEOPS_RAG_TOP_K。
SERVICEOPS_RAG_HYBRID_DENSE_K=8
SERVICEOPS_RAG_HYBRID_LEXICAL_K=8
# RRF_K 是排名平滑常数，不是候选数；两路权重用于表达业务偏好。
SERVICEOPS_RAG_HYBRID_RRF_K=60
SERVICEOPS_RAG_HYBRID_DENSE_WEIGHT=1.0
SERVICEOPS_RAG_HYBRID_LEXICAL_WEIGHT=0.8
SERVICEOPS_RAG_CHUNK_SIZE=500
SERVICEOPS_RAG_CHUNK_OVERLAP=80

# extractive 使用确定性证据组织，零额外费用；llm 使用真实聊天模型进行受约束生成。
SERVICEOPS_RAG_GENERATION_BACKEND=extractive
# 送入生成模型的证据总字符上限，避免无边界上下文增加延迟和费用。
SERVICEOPS_RAG_MAX_CONTEXT_CHARS=4000
