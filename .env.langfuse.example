# 复制为 .env.langfuse 后再填写；该目标文件已被 Git 忽略。
# 云端默认使用 https://cloud.langfuse.com/api/public/otel；自托管请替换为对应域名。
SERVICEOPS_OTEL_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# 先计算 base64(public_key:secret_key)，只把结果写入未提交的 .env.langfuse。
SERVICEOPS_OTEL_OTLP_HEADERS=Authorization=Basic replace-with-base64,x-langfuse-ingestion-version=4

