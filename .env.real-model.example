# 复制为 .env.real-model 后填写；该真实文件已被 .gitignore 排除。
# 示例以阿里云百炼 OpenAI 兼容接口为例，也可替换为其他兼容服务商。
SERVICEOPS_LLM_API_KEY=replace-with-your-api-key
SERVICEOPS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SERVICEOPS_LLM_MODEL=qwen-plus

# Embedding 与聊天模型共用兼容接口和 API Key；维度必须匹配所选模型。
SERVICEOPS_EMBEDDING_MODEL=text-embedding-v4
SERVICEOPS_EMBEDDING_DIMENSIONS=1024
SERVICEOPS_EMBEDDING_BATCH_SIZE=10

# 真实语义向量分布与 hash 基线不同，首次演示前必须用评测集重新校准阈值。
SERVICEOPS_RAG_SCORE_THRESHOLD=0.45
SERVICEOPS_LLM_TIMEOUT_SECONDS=30
SERVICEOPS_LLM_MAX_RETRIES=1
