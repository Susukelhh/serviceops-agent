# Python 解释器产生的缓存文件
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境与本地环境变量
.venv/
.venv-py313-backup/
.env
.env.real-model
.env.langfuse

# 测试、类型检查和代码质量工具的缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 本地测试沙盒和一次性文档/PDF检查产物不属于发布源码
.tmp/
tmp/

# 构建产物
build/
dist/
*.egg-info/

# 本地 Qdrant 索引、Checkpoint 和业务 SQLite 都是运行数据，不提交二进制文件
data/runtime/

# PostgreSQL 备份可能包含业务、审计和对话状态，只能进入受控备份介质
data/backups/

# 编辑器与操作系统临时文件
.idea/
.vscode/
.DS_Store
Thumbs.db

# 不上传个人简历材料
career/resume/

# Sphinx 本地构建产物可以随时由源文档重新生成，不提交到 Git。
docs/readthedocs-guide/_build/

# 外部面经参考资料只在本机学习，不属于本项目源代码，也可能包含第三方示例配置。
ai-agent-interview-guide-main/
ai-agent-interview-guide-main.lnk
# 本机磁盘空间分析工具生成的报告，与 ServiceOps Agent 项目无关。
storage_analysis.json

# 真正的盲测题目与事实金标不能提前进入公开仓库；仓库只保存数量、SHA-256 和脱敏结果。
data/private_evaluation/
