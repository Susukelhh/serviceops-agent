# Python 解释器产生的缓存文件
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境与本地环境变量
.venv/
.venv-py313-backup/
.env

# 测试、类型检查和代码质量工具的缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 构建产物
build/
dist/
*.egg-info/

# 本地 Qdrant 索引、Checkpoint 和业务 SQLite 都是运行数据，不提交二进制文件
data/runtime/

# PostgreSQL 备份可能包含业务、审计和对话状态，只能进入受控备份介质
data/backups/

# 编辑器与操作系统临时文件
.idea/
.vscode/
.DS_Store
Thumbs.db

# 不上传个人简历材料
career/resume/